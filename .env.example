# ─── Anthropic API ───────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# ─── Email (SMTP) ───────────────────────────────────
# Gmail example — you'll need an App Password (not your regular password)
# See: https://support.google.com/accounts/answer/185833
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password-here
SMTP_USE_TLS=true

# Sender and recipient (defaults to SMTP_USER if not set)
EMAIL_FROM=your-email@gmail.com
EMAIL_TO=your-email@gmail.com

# ─── Subscriber list (optional) ──────────────────────────
# Published CSV URL of a Google Sheet collecting subscriber emails.
# Leave blank to send only to the EMAIL_TO core list.
SUBSCRIBER_CSV_URL=

# ─── Optional ────────────────────────────────────────
# Override the Claude model (default: claude-sonnet-4-5)
# CLAUDE_MODEL=claude-sonnet-4-5

# Set to false to skip the Excel archive step (used by the test workflow)
# ARCHIVE_ENABLED=true
